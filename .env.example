# ==========================================
# AI Content Studio - Environment Configuration
# ==========================================

# LLM Providers (Google Gemini or Groq or OpenAI)
# Google AI Studio Gemini API Key (generous free tier: https://aistudio.google.com/)
GEMINI_API_KEY=
# Groq API Key (ultra-fast free tier: https://console.groq.com/)
GROQ_API_KEY=
# OpenAI API Key (optional)
OPENAI_API_KEY=

# Text-to-Video Providers
# Hugging Face API Token (free tier: https://huggingface.co/settings/tokens)
HUGGINGFACE_API_KEY=

# Voice / TTS Providers
# ElevenLabs API Key (optional free tier: https://elevenlabs.io)
ELEVENLABS_API_KEY=
# Default Voice Provider: "edge_tts" (100% Free, Neural quality, No Key Required) or "elevenlabs"
DEFAULT_VOICE_PROVIDER=edge_tts

# Application Settings
DATABASE_URL=sqlite:///./content_studio.db
OUTPUT_DIR=generated
MAX_RETRIES=2
LOG_LEVEL=INFO

# Server Config
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
